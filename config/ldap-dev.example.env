# Параметры для будущего -auth-backend=ldap (dev-стенд docker-compose.dev.yml)
LDAP_URL=ldap://127.0.0.1:1389
LDAP_BASE_DN=dc=oktopus,dc=dev
LDAP_BIND_DN=cn=admin,dc=oktopus,dc=dev
LDAP_BIND_PASSWORD=admin_dev
# Проверка членства: фильтр (member=<user DN>) по ou=groups, не memberOf (OpenLDAP по умолчанию).
LDAP_USER_FILTER=(uid=%s)
LDAP_USER_BASE_DN=ou=people,dc=oktopus,dc=dev
LDAP_GROUP_ALLOW=cn=allow_all,ou=groups,dc=oktopus,dc=dev
LDAP_GROUP_DENY=cn=deny_all,ou=groups,dc=oktopus,dc=dev
