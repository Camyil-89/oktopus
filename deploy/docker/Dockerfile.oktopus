# syntax=docker/dockerfile:1

FROM golang:1.24-bookworm AS build
WORKDIR /src

ENV GOTOOLCHAIN=auto
ENV CGO_ENABLED=0

COPY go.mod go.sum ./
RUN go mod download

COPY cmd ./cmd
COPY internal ./internal
COPY db ./db

RUN go build -trimpath -ldflags="-s -w" -o /out/oktopus ./cmd

FROM debian:bookworm-slim AS run
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=build /out/oktopus ./oktopus
COPY db/migrations ./db/migrations
COPY config/forbidden.default.html config/forbidden.minimal.html ./config/

EXPOSE 8000 8080

ENTRYPOINT ["./oktopus", "serve", "-migrations", "db/migrations"]
