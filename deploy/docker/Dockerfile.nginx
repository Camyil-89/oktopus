# syntax=docker/dockerfile:1
# UI: статический export Next.js в /usr/share/nginx/html

FROM node:22-alpine AS web-build
WORKDIR /app

COPY web/package.json web/package-lock.json ./
RUN npm ci

COPY web/ ./

ARG NEXT_PUBLIC_API_URL=
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_OUTPUT=export
ENV NEXT_TELEMETRY_DISABLED=1

RUN npm run build

FROM nginx:1.27-alpine

ENV OKTOPUS_API_INTERNAL_PORT=18002
ENV OKTOPUS_API_UPSTREAM_HOST=host.docker.internal

COPY --from=web-build /app/out /usr/share/nginx/html
COPY deploy/docker/nginx/oktopus.local.conf.template /etc/nginx/templates/default.conf.template
