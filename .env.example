# --- PostgreSQL (dev: docker-compose.dev.yml, порт 5434 на хосте) ---

DATABASE_URL=postgres://oktopus:oktopus@127.0.0.1:5434/oktopus?sslmode=disable

# --- ClickHouse (журнал доступа прокси; native :9054, HTTP :8177 на хосте) ---

CLICKHOUSE_ADDR=127.0.0.1:9054
CLICKHOUSE_DATABASE=oktopus
CLICKHOUSE_USER=oktopus
CLICKHOUSE_PASSWORD=oktopus

# --- HTTP API (internal/api/config, internal/db bootstrap) ---

# CORS origins через запятую (по умолчанию http://localhost:3000)
# OKTOPUS_CORS_ORIGINS=http://localhost:3000

# Cookie Secure для сессии (true/1 за HTTPS)
# OKTOPUS_COOKIE_SECURE=false

# Учётка администратора при первом bootstrap в БД (по умолчанию admin / admin)
# OKTOPUS_ADMIN_USERNAME=admin
# OKTOPUS_ADMIN_PASSWORD=admin

# --- Web (Next.js) ---
# Локально удобнее web/.env.local (не коммитить). При docker build — build-arg в Dockerfile.web.
#
# Базовый URL API для браузера (без завершающего /). Пустая строка — относительные /api/* (nginx).
# NEXT_PUBLIC_API_URL=http://localhost:8000
