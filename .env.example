# Скопируйте в .env при необходимости (docker compose подхватывает автоматически).

# ClickHouse: том Docker (работает с репозиторием на D:\ в Docker Desktop).
# OKTOPUS_CLICKHOUSE_VOLUME=oktopus_clickhouse_data

# Данные CH в docker_data/clickhouse рядом с postgres — только при запуске compose
# из WSL/Linux, когда проект на ext4 (~/oktopus), не /mnt/d/...
# OKTOPUS_CLICKHOUSE_VOLUME=./docker_data/clickhouse
